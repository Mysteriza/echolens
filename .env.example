YOUTUBE_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=postgresql+asyncpg://echolens:echolens_password@localhost:5432/echolens_db
APP_ENV=development
LOG_LEVEL=INFO
# Optional: protects POST /api/videos/reset-database via header X-Admin-Token.
# Leave empty for local dev; ALWAYS set in production/shared environments.
ADMIN_TOKEN=
# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Server-side caps (frontend settings UI clamps within these).
MAX_PROCESS_LIMIT=2000
MAX_COMMENT_PAGE_SIZE=100
MAX_CHAT_CONTEXT=100
MAX_QUESTION_LENGTH=1000
CHAT_CONTEXT_FRACTION=0.25
CHAT_CONTEXT_MIN=20
